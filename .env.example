# Copy this file to .env and fill it in. Never commit .env.
# Left empty, the app runs in demo mode on port 3000 with till 1234.

# true (default) skips Safaricom completely. Set to false for real STK pushes.
DEMO_MODE= false

# sandbox or production
MPESA_ENV= production

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=

# BusinessShortCode sent to Daraja (your store / head office number)
MPESA_SHORTCODE= 1894476


# Till number that receives the money (PartyB)
MPESA_TILL= 1424143

# Public https address of this server, without a trailing slash
CALLBACK_BASE_URL=

PORT=
